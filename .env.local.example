# Firebase client config (Firebase Console -> Project settings -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=notesapp-a1402
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only: full service-account JSON as ONE line. Never NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cloudflare R2 (server-only keys)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=notesapp-media
# Public URL of the bucket (custom domain or pub-<hash>.r2.dev)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Paystack (Dashboard -> Settings -> API Keys & Webhooks). Server-only.
PAYSTACK_SECRET_KEY=
# Used for the payment redirect; falls back to the request origin.
NEXT_PUBLIC_SITE_URL=https://www.notesapp.name.ng

# Reminder + confirmation emails (Resend). Without a key emails are skipped.
RESEND_API_KEY=
EMAIL_FROM="#NotesApp <bookings@notesapp.name.ng>"
# Shared secret for /api/cron/reminders (Authorization: Bearer <value>)
CRON_SECRET=
