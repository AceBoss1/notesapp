# Firebase client config (Firebase Console -> Project settings -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=notesapp-a1402
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only: full service-account JSON as ONE line. Never NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cloudflare R2 (server-only keys)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=notesapp-media
# Public URL of the bucket (custom domain or pub-<hash>.r2.dev)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Paystack (Dashboard -> Settings -> API Keys & Webhooks). Server-only.
PAYSTACK_SECRET_KEY=
# Used for the payment redirect; falls back to the request origin.
NEXT_PUBLIC_SITE_URL=https://www.notesapp.name.ng

# Reminder + confirmation emails (Resend). Without a key emails are skipped.
RESEND_API_KEY=
EMAIL_FROM="#NotesApp <bookings@notesapp.name.ng>"
# Shared secret for /api/cron/reminders (Authorization: Bearer <value>)
CRON_SECRET=

# Private R2 bucket for paid digital downloads (just the bucket's name; the R2 token above must cover it too)
R2_PRIVATE_BUCKET=

# Support inbox for error alerts and disputes (default hello@notesapp.name.ng)
SUPPORT_EMAIL=

# Pause automatic payout release with AUTO_PAYOUTS=off
AUTO_PAYOUTS=
# Salt for hashing ad-visitor ids
AD_HASH_SALT=

# Dojah identity checks (sandbox until go-live: see README "Dojah go-live checklist")
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_WEBHOOK_SECRET=
DOJAH_API_BASE=
NEXT_PUBLIC_DOJAH_WIDGET_PERSONAL=
NEXT_PUBLIC_DOJAH_WIDGET_CORPORATE=
# Leave unset: true would auto-approve gold applications whose every step passed
DOJAH_AUTO_APPROVE=

# Optional: auto-connect Enterprise custom domains and check Vercel on /status
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
CLOUDFLARE_STREAM_TOKEN=

# Domain sales (Whogohost / go54 reseller API). Server-only; never commit real values.
WHOGOHOST_RESELLER_EMAIL=
WHOGOHOST_API_KEY=
# Optional: an HTTP(S) proxy with a fixed outgoing IP (http://user:pass@host:port). Whogohost calls go through it when set.
WHOGOHOST_PROXY_URL=

# Publishing a post to a member's own LinkedIn / X (each network appears only when its two values are set; ACCOUNT_DATA_KEY encrypts the saved tokens).
# Redirect URI to register with each app: https://www.notesapp.name.ng/api/social/callback/linkedin  and  .../callback/x
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202606
X_CLIENT_ID=
X_CLIENT_SECRET=
