rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'ezurukam@gmail.com',
        'precheks.info@gmail.com'
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Notes ────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount']);

      match /likes/{uid} {
        allow read, create, delete: if isSignedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSignedIn()
          && (
            // comment author editing their own text, or an admin moderating
            request.auth.uid == resource.data.authorUid
            || isAdmin()
            // OR any signed-in user bumping/undoing the like counter only
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          );
        allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.authorUid || isAdmin());

        // Per-user like record on a comment, same pattern as note likes.
        match /commentLikes/{uid} {
          allow read, create, delete: if isSignedIn() && request.auth.uid == uid;
        }
      }
    }

    // ── Comments (collection group access) ─────────────────────
    // Needed separately from the nested rule above: collection group
    // queries (e.g. getCountFromServer(collectionGroup(db, "comments")))
    // are only validated against rules written with the recursive
    // wildcard {path=**}. The nested match /notes/{noteId}/comments/{commentId}
    // rule above only covers reads scoped to one note at a time and does
    // NOT satisfy a cross-note collection group query.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // ── Public profiles ──────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── Username reservations (uniqueness) ───────────────────
    // "notesapp" anywhere in the username is blocked outright — no
    // *notesapp, notesapp*, or notesapp-in-the-middle variant is
    // reservable by a member. This exists so nobody can register
    // something that impersonates the platform itself; it has nothing
    // to do with @notesapp or @na-notesapp, since neither ever goes
    // through this path — both are hardcoded (lib/journals-directory.ts)
    // and never have a doc in this collection at all.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !username.lower().matches('.*notesapp.*');
      allow delete: if false;
    }

    // ── Site-wide settings (contact email, WhatsApp, socials) ─
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Follows (#NotesApp-only — no Precheks equivalent) ─────
    // Doc id: `${followerUid}_${username}`. A member can only ever
    // write their own follow relationship, never one on someone
    // else's behalf. Mandatory follows (@notesapp + both founders)
    // can't be deleted by anyone here — same rule for every account,
    // since there's no paid-tier flag on a user yet to make an
    // exception for (see lib/follows.ts).
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.followerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.followerUid == request.auth.uid
        && resource.data.mandatory != true;
    }

    // ── Subscriptions (#NotesApp-only) ────────────────────────
    // Doc id: `${subscriberUid}_${username}`. No payment gateway
    // wired yet — every doc here has status:"demo" (see
    // lib/subscriptions.ts).
    //
    // Read is public, same as follows — a subscriber count is shown
    // on journal cards the same way a follower count is, and
    // getSubscriberCount() runs an aggregation query across every
    // subscriber of a given username, not just the current user's own
    // doc, so it can't be restricted to "read your own record only."
    // The only thing actually gated by a subscription — a premium
    // note's content — is never in this collection; PremiumGate reads
    // isSubscribed(), which only ever checks the signed-in user's own
    // doc, so this doesn't weaken the paywall.
    // Writes stay owner-only: nobody can create or delete a
    // subscription on someone else's behalf.
    match /subscriptions/{subId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.subscriberUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.subscriberUid == request.auth.uid;
    }
  }
}
