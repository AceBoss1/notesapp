rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = Firebase custom claim `admin: true` (set with
    // scripts/set-admin-claims.mjs or /api/admin/set-admin).
    // The email list below is the TEMPORARY legacy path so nobody is
    // locked out mid-migration. Once both founders have the claim
    // (sign out/in, check /admin works), delete isLegacyAdminEmail()
    // and its use here — see README "Custom-claims admin".
    function isLegacyAdminEmail() {
      return request.auth.token.email in [
        'ezurukam@gmail.com',
        'precheks.info@gmail.com'
      ];
    }

    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true || isLegacyAdminEmail());
    }

    // A self-serve paid/free-basic-publisher account, or an internal
    // staff/volunteer designation — either grants publish permission
    // over one's own notes. Deliberately does NOT include role==
    // 'admin' — admin is covered separately by isAdmin() (the 2
    // hardcoded founder emails) everywhere this is checked; keeping
    // them separate here means this function's meaning stays exactly
    // "the self-serve or internal-writer path," not "any of the three
    // ways in." Mirrors lib/users.ts's canPublish() — keep both in
    // sync if this logic ever changes; a Firestore rule can't import
    // a TS function. "standard" is the only tier that can't publish —
    // basic/pro/business/enterprise all can.
    function isPublisher() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role in ['staff', 'volunteer']
          || get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.accountTier != 'standard'
        );
    }

    // Suspended members are prevented from creating comments.
    // NOTE: the app's actual suspend feature writes a flat
    // `suspended: true/false` boolean field on users/{uid} — not a
    // `status` enum. This checks that real field.
    function isSuspended() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.suspended == true;
    }


    // ============================================================
    // NOTES
    // ============================================================

    match /notes/{noteId} {

      // Published notes are public. Drafts are readable only by their
      // author and admins (queries must filter on status == 'published'
      // or authorUid == the caller's uid to be allowed).
      allow read: if resource.data.status == 'published'
        || isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // Admins can create anything.
      // Writers can create only notes authored by themselves.
      // coAuthors / coAuthorUids are written only by /api/coauthors (consent).
      allow create: if isAdmin()
        || (
          isPublisher()
          && request.resource.data.authorUid == request.auth.uid
          && !request.resource.data.keys().hasAny(['coAuthors', 'coAuthorUids'])
        );

      // Admins can delete anything.
      // Writers can delete only their own notes.
      allow delete: if isAdmin()
        || (
          isPublisher()
          && resource.data.authorUid == request.auth.uid
        );

      // Updates:
      // 1. Admins can update anything.
      // 2. Writers can update their own notes.
      // 3. Anyone can increment viewCount.
      // 4. Signed-in users can update likeCount.
      // 5. Anyone can update shareCount.
      allow update: if isAdmin()
        || (
          isPublisher()
          && resource.data.authorUid == request.auth.uid
          && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['coAuthors', 'coAuthorUids'])
        )
        || request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['viewCount'])
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['likeCount'])
        )
        || request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['shareCount']);


      // ==========================================================
      // NOTE LIKES
      // ==========================================================

      match /likes/{uid} {
        allow read, create, delete: if isSignedIn()
          && request.auth.uid == uid;
      }


      // ==========================================================
      // COMMENTS
      // ==========================================================

      match /comments/{commentId} {

        // Comments are public.
        allow read: if true;

        // A signed-in user can create a comment only as themselves.
        // Suspended users cannot create comments.
        allow create: if isSignedIn()
          && !isSuspended()
          && request.resource.data.authorUid == request.auth.uid;

        // Comment updates:
        // - author can edit own comment
        // - admins can moderate
        // - signed-in users can modify only likeCount
        allow update: if isSignedIn()
          && (
            request.auth.uid == resource.data.authorUid
            || isAdmin()
            || request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['likeCount'])
          );

        // Author or admin can delete.
        allow delete: if isSignedIn()
          && (
            request.auth.uid == resource.data.authorUid
            || isAdmin()
          );


        // ========================================================
        // COMMENT LIKES
        // ========================================================

        match /commentLikes/{uid} {
          allow read, create, delete: if isSignedIn()
            && request.auth.uid == uid;
        }
      }
    }


    // ============================================================
    // COMMENTS COLLECTION-GROUP READ ACCESS
    // ============================================================

    // Required for queries such as:
    // collectionGroup(db, "comments")
    //
    // The nested /notes/{noteId}/comments rule above does not
    // automatically authorise collection-group queries.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }


    // ============================================================
    // USERS / PUBLIC PROFILES
    // ============================================================

    match /users/{uid} {

      // Public profiles.
      allow read: if true;

      // A user can create only their own profile.
      // No `email` key: emails live only in Firebase Authentication, and
      // this document is publicly readable.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && !('email' in request.resource.data);

      // Admins can manage profiles.
      //
      // Ordinary users may edit only ordinary profile fields.
      // They cannot modify role, status, verification or suspension.
      //
      // (Suspension reason/appeal live in the private suspensions/{uid}.)
      allow update: if

        // --------------------------------------------------------
        // 1. ADMIN
        // --------------------------------------------------------
        isAdmin()

        // --------------------------------------------------------
        // 2. ORDINARY PROFILE EDIT
        // --------------------------------------------------------
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'displayName',
                'bio',
                'avatar',
                'social'
              ])
        );

      // User deletion is disabled.
      allow delete: if false;
    }


    // ============================================================
    // SUSPENSIONS (private: the member and admins only)
    // ============================================================

    match /suspensions/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // A suspended member can only file an appeal.
        || (
          isSignedIn()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/users/$(uid)).data.suspended == true
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['appealStatus', 'appealText', 'appealedAt'])
          && request.resource.data.appealStatus == 'pending'
        );
    }


    // ============================================================
    // GOLD-BADGE ENDORSEMENT REQUESTS (private; created by the server)
    // ============================================================

    // Official merch pre-orders — owner + admins read; server-only writes.
    match /merchOrders/{ref} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Co-author invites (and the agreed earnings split): the lead, the invitee
    // and admins read; the server route is the only writer.
    match /coAuthorInvites/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.leadUid == request.auth.uid || resource.data.inviteeUid == request.auth.uid));
      allow write: if false;
    }

    // Paid gold-badge subscription records — owner + admins read; server writes.
    match /goldSubscriptions/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /badgeRequests/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update: if isAdmin();
      allow create, delete: if false;
    }


    // ============================================================
    // USERNAME RESERVATIONS
    // ============================================================

    match /usernames/{username} {

      allow read: if true;

      // A signed-in user can reserve their own username.
      //
      // "notesapp" is blocked anywhere in the username to prevent
      // platform impersonation.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !username.lower().matches('.*notesapp.*');

      // Username reservations cannot be deleted directly.
      allow delete: if false;
    }


    // ============================================================
    // SITE-WIDE SETTINGS
    // ============================================================

    match /settings/{docId} {

      // Public configuration such as contact email,
      // WhatsApp and social links.
      allow read: if true;

      // Only admins can change site-wide settings.
      allow write: if isAdmin();
    }


    // ============================================================
    // STORE ITEMS — a publisher's own storefront listings (external
    // links; no money moves through NotesApp here)
    // ============================================================

    function validStoreItem(d) {
      return d.keys().hasOnly(['ownerUid', 'title', 'subtitle', 'price', 'badge', 'link', 'image', 'cta', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['ownerUid', 'title', 'price', 'link', 'image', 'cta'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && (!('subtitle' in d) || (d.subtitle is string && d.subtitle.size() <= 400))
        && d.price is string && d.price.size() <= 24
        && (!('badge' in d) || (d.badge is string && d.badge.size() <= 24))
        && d.link is string && d.link.matches('https://.*') && d.link.size() <= 500
        && d.image is string && d.image.size() <= 500
        && d.cta is string && d.cta.size() > 0 && d.cta.size() <= 30;
    }

    match /storeItems/{itemId} {
      allow read: if true;
      allow create: if isAdmin()
        || (isPublisher() && request.resource.data.ownerUid == request.auth.uid
            && validStoreItem(request.resource.data));
      allow update: if isAdmin()
        || (isPublisher() && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
            && validStoreItem(request.resource.data));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }


    // ============================================================
    // FOLLOWS — NOTESAPP
    // ============================================================

    match /follows/{followId} {

      // Public because follower counts are displayed publicly.
      allow read: if true;

      // A user can create a follow only for themselves.
      allow create: if isSignedIn()
        && request.resource.data.followerUid == request.auth.uid;

      // Follow records cannot be edited.
      allow update: if false;

      // A user can remove their own non-mandatory follow.
      allow delete: if isSignedIn()
        && resource.data.followerUid == request.auth.uid
        && resource.data.mandatory != true;
    }


    // ============================================================
    // SUBSCRIPTIONS — NOTESAPP
    // ============================================================

    match /subscriptions/{subId} {

      // Public because subscriber counts are displayed publicly.
      allow read: if true;

      // Created/renewed only by the server after Paystack confirms a
      // charge (Admin SDK bypasses rules). No more free client writes.
      allow create, update: if false;

      // A subscriber can remove their own subscription record.
      allow delete: if isSignedIn()
        && resource.data.subscriberUid == request.auth.uid;
    }


    // ============================================================
    // BOOKINGS + PAYMENTS — NOTESAPP (Paystack)
    // Written only by the server (Admin SDK bypasses rules) after
    // Paystack confirms a charge. Clients can never write these.
    // ============================================================

    // One doc per booked slot; server-only (Admin SDK). No client access at all.
    // Visit counters for the trending feed — server-only (Admin SDK).
    match /pageViews/{id} {
      allow read, write: if false;
    }

    // Pro/Business plan records — owner + admins read; server-only writes.
    match /tierSubscriptions/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /badgeSubscriptions/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /platformPlans/{id} {
      allow read, write: if false;
    }
    match /tierCharges/{id} {
      allow read, write: if false;
    }

    // Boost campaigns: the buyer (and admins) can read their stats; only the server writes.
    match /boosts/{boostId} {
      allow read: if isSignedIn()
        && (resource.data.publisherUid == request.auth.uid || isAdmin());
      allow write: if false;
      match /seen/{seenId} {
        allow read, write: if false;
      }
    }

    // Gifts: recipient, sender and admins can read; server-written only.
    match /gifts/{giftId} {
      allow read: if isSignedIn()
        && (resource.data.toUid == request.auth.uid
            || resource.data.fromUid == request.auth.uid
            || isAdmin());
      allow write: if false;
    }

    match /slotLocks/{lockId} {
      allow read, write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.clientUid == request.auth.uid
            || resource.data.publisherUid == request.auth.uid
            || isAdmin());
      allow write: if false;
    }

    // Publisher rates + availability: public (shown on profiles),
    // written only by /api/publisher/settings after validation.
    match /publisherSettings/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Where a publisher is paid — owner (and admins) can read, never write.
    match /payoutAccounts/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Earnings ledger: publishers see their own entries; admins all.
    match /ledger/{reference} {
      allow read: if isSignedIn()
        && (resource.data.publisherUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /payments/{reference} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }


    // ============================================================
    // LEADS — PRECHEKS
    // ============================================================

    match /leads/{leadId} {

      // Public contact form submission.
      //
      // The visitor does not need to be authenticated.
      // Restrict the fields and require status = "new".
      allow create: if
        request.resource.data.keys().hasOnly([
          'name',
          'email',
          'category',
          'message',
          'status',
          'createdAt'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.category is string
        && request.resource.data.message is string;

      // Lead information is private.
      // Only admins can access or manage it.
      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // NOTIFICATIONS — NOTESAPP
    // ============================================================
    //
    // No Cloud Functions in this deployment — every notification is
    // written directly by whichever client action caused it (the
    // liker's browser writes a doc addressed to the note's author,
    // not the author's own browser). That means creation can only be
    // shape-validated here, not verified against "did this really
    // happen" the way a trusted server-side function could — a
    // motivated user could write a fake notification to any uid. Low
    // severity: it's a fake in-app message, not a data leak or a
    // permission escalation, and only the recipient can ever read it.
    // If this becomes a real abuse vector, the fix is a Cloud
    // Function that owns notification creation instead of the client.
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (resource.data.recipientUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.recipientUid is string
        && request.resource.data.type in [
             'like', 'comment', 'reply', 'new_post',
             'suspended', 'unsuspended', 'appeal_rejected', 'role_changed'
           ]
        && request.resource.data.message is string
        && request.resource.data.read == false
        && request.resource.data.createdAt is string;

      // A recipient can only ever flip their own notification to
      // read — nothing else about it, and never someone else's.
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

  }
}