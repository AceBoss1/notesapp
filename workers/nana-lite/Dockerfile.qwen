# Qwen2.5-1.5B-Instruct (1.5B, Apache-2.0), 4-bit, from Qwen's own GGUF repository. Check the file name before building.
FROM ghcr.io/ggml-org/llama.cpp:server
ADD https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf /models/model.gguf
EXPOSE 8080
CMD ["-m", "/models/model.gguf", "--host", "0.0.0.0", "--port", "8080", "-c", "4096", "--alias", "qwen2.5-1.5b-instruct"]
